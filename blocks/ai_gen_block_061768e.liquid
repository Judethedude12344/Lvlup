{% doc %}
  @prompt
    Make me a dark comparison chart that compares my product to other similar products. Make the chart almost as big as the whole screen. Highlight my product as the winning product. Make sure the horizontal and vertical lines are visible. add option to add a title to the chart, add option to change color of the highlighted column. and add option to add couple more competitors and features, Make the columns of the products even spacing. Even if the name is longer, make the box bigger for all, but keep the same length. And if i add a new column, make it automatically adjust the sizes of the box to accordingly. All even, make the sizes of the column header title adjustable. for the winning badge, make the badge show more visible., For the Features column table header, I can adjust the size of that column title. For the winner badge, make it on the top right still just show the whole badge but make it on top right and small. , Make the badge stick out of the column. Like on the top right corner, make the badge stick out of the chart a little. Don't block the words in the column. MAke the badge size adjustable, make this chart compatible for mobile as well. Make all the options to adjust the chart to mobile. make the winner badge only be in the our product column. make the columns and rows header titles seperate color options
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-chart-{{ ai_gen_id }} {
    width: 100%;
    min-height: 90vh;
    background-color: {{ block.settings.background_color }};
    padding: 40px 20px;
    overflow-x: auto;
  }

  .ai-comparison-chart-container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
  }

  .ai-comparison-chart-title-{{ ai_gen_id }} {
    text-align: center;
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_size }}px;
    margin-bottom: 40px;
    font-weight: 700;
  }

  .ai-comparison-table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid {{ block.settings.border_color }};
    background-color: {{ block.settings.table_background }};
  }

  .ai-comparison-table-{{ ai_gen_id }} th,
  .ai-comparison-table-{{ ai_gen_id }} td {
    border: 1px solid {{ block.settings.border_color }};
    padding: 20px;
    text-align: center;
    color: {{ block.settings.text_color }};
    position: relative;
  }

  .ai-comparison-table-{{ ai_gen_id }} thead th {
    font-weight: 700;
    background-color: {{ block.settings.column_header_background }};
    color: {{ block.settings.column_header_text_color }};
    vertical-align: top;
    padding-top: 30px;
  }

  .ai-comparison-table-{{ ai_gen_id }} thead th:first-child {
    text-align: left;
    font-size: {{ block.settings.features_column_size }}px;
    background-color: {{ block.settings.row_header_background }};
    color: {{ block.settings.row_header_text_color }};
  }

  .ai-comparison-table-{{ ai_gen_id }} tbody th {
    text-align: left;
    font-weight: 600;
    background-color: {{ block.settings.row_header_background }};
    color: {{ block.settings.row_header_text_color }};
  }

  .ai-comparison-winner-{{ ai_gen_id }} {
    background-color: {{ block.settings.winner_column_color }} !important;
    position: relative;
  }

  .ai-comparison-product-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_name_size }}px;
    font-weight: 700;
    display: block;
    margin-bottom: 10px;
  }

  .ai-comparison-badge-{{ ai_gen_id }} {
    position: absolute;
    top: {{ block.settings.badge_offset }}px;
    right: {{ block.settings.badge_offset }}px;
    background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
    color: #000;
    padding: 8px 16px;
    border-radius: 20px;
    font-weight: 700;
    font-size: {{ block.settings.badge_size }}px;
    box-shadow: 0 4px 12px rgba(255, 215, 0, 0.4);
    z-index: 10;
    white-space: nowrap;
    transform: translate(25%, -25%);
  }

  .ai-comparison-badge-{{ ai_gen_id }}::before {
    content: '⭐';
    margin-right: 6px;
  }

  .ai-comparison-checkmark-{{ ai_gen_id }} {
    color: #4CAF50;
    font-size: 24px;
    font-weight: 700;
  }

  .ai-comparison-cross-{{ ai_gen_id }} {
    color: #f44336;
    font-size: 24px;
    font-weight: 700;
  }

  @media screen and (max-width: 768px) {
    .ai-comparison-chart-{{ ai_gen_id }} {
      min-height: {{ block.settings.mobile_min_height }}vh;
      padding: {{ block.settings.mobile_padding }}px {{ block.settings.mobile_padding | divided_by: 2 }}px;
    }

    .ai-comparison-chart-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_title_size }}px;
      margin-bottom: {{ block.settings.mobile_title_margin }}px;
    }

    .ai-comparison-table-{{ ai_gen_id }} th,
    .ai-comparison-table-{{ ai_gen_id }} td {
      padding: {{ block.settings.mobile_cell_padding }}px;
      font-size: {{ block.settings.mobile_text_size }}px;
    }

    .ai-comparison-table-{{ ai_gen_id }} thead th:first-child {
      font-size: {{ block.settings.mobile_features_column_size }}px;
    }

    .ai-comparison-product-name-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_product_name_size }}px;
      margin-bottom: 5px;
    }

    .ai-comparison-badge-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_badge_size }}px;
      padding: {{ block.settings.mobile_badge_padding }}px {{ block.settings.mobile_badge_padding | times: 1.5 }}px;
      top: {{ block.settings.mobile_badge_offset }}px;
      right: {{ block.settings.mobile_badge_offset }}px;
    }

    .ai-comparison-checkmark-{{ ai_gen_id }},
    .ai-comparison-cross-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_icon_size }}px;
    }
  }
{% endstyle %}

