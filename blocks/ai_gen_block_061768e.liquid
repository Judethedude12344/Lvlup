{% schema %}
{
  "name": "Product comparison chart",
  "settings": [
    {
      "type": "header",
      "content": "Chart title"
    },
    {
      "type": "text",
      "id": "chart_title",
      "label": "Title",
      "default": "Why Choose Us?"
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Title size",
      "default": 36
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "table_background",
      "label": "Table background",
      "default": "#2a2a2a"
    },
    {
      "type": "color",
      "id": "column_header_background",
      "label": "Column header background",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "column_header_text_color",
      "label": "Column header text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "row_header_background",
      "label": "Row header background",
      "default": "#2a2a2a"
    },
    {
      "type": "color",
      "id": "row_header_text_color",
      "label": "Row header text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#444444"
    },
    {
      "type": "color",
      "id": "winner_column_color",
      "label": "Winner column highlight",
      "default": "#1e3a2e"
    },
    {
      "type": "header",
      "content": "Winner badge"
    },
    {
      "type": "text",
      "id": "winner_badge_text",
      "label": "Badge text",
      "default": "BEST CHOICE"
    },
    {
      "type": "range",
      "id": "badge_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Badge size",
      "default": 14
    },
    {
      "type": "range",
      "id": "badge_offset",
      "min": -20,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Badge position offset",
      "default": -10
    },
    {
      "type": "header",
      "content": "Table headers"
    },
    {
      "type": "text",
      "id": "features_header",
      "label": "Features column header",
      "default": "Features"
    },
    {
      "type": "range",
      "id": "features_column_size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Features column size",
      "default": 18
    },
    {
      "type": "range",
      "id": "product_name_size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
