{% doc %}
  @prompt
    For this section Were going to create a modern shopify seciton similiar to a comparison or problem seciton seen on premium DTC brands. The section should include a small label at the top reading "THE PROBLEM". Under this a Bold headline bigger than the label reading"Traditional Cold Therapy Fails You" With Fails you being our theme blue. Then under this is a short supporting sentence reading "Current solutions are expensive, inconvenient, and impractical for daily use." Under this will be 3 rounded comparison cards. Each card should include an image, a title, and several bullet points with red X icons indicating the downsides of existing solutions. The design should be clean, minimal, and modern with a light neutral bakground, subtle shadows, rounded corners, and a wellness/tech aesthetic. Everything must be fully editable: images, background colors,text, fonts, icon colors, spacing, and layout. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-problem-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-problem-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
  }

  .ai-problem-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-problem-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.label_font_size }}px;
    font-weight: {{ block.settings.label_font_weight }};
    color: {{ block.settings.label_color }};
    letter-spacing: {{ block.settings.label_letter_spacing }}px;
    margin-bottom: {{ block.settings.label_spacing }}px;
    text-transform: uppercase;
  }

  .ai-problem-headline-{{ ai_gen_id }} {
    font-size: {{ block.settings.headline_font_size }}px;
    font-weight: {{ block.settings.headline_font_weight }};
    color: {{ block.settings.headline_color }};
    margin-bottom: {{ block.settings.headline_spacing }}px;
    line-height: 1.2;
  }

  .ai-problem-headline-accent-{{ ai_gen_id }} {
    color: {{ block.settings.headline_accent_color }};
  }

  .ai-problem-subtext-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtext_font_size }}px;
    color: {{ block.settings.subtext_color }};
    max-width: {{ block.settings.subtext_max_width }}px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .ai-problem-cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.cards_per_row_desktop }}, 1fr);
    gap: {{ block.settings.card_gap }}px;
    margin-top: {{ block.settings.cards_top_spacing }}px;
  }

  .ai-problem-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: 0 {{ block.settings.card_shadow_y }}px {{ block.settings.card_shadow_blur }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 }});
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-problem-card-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.card_hover_lift }}px);
    box-shadow: 0 {{ block.settings.card_shadow_y | plus: 4 }}px {{ block.settings.card_shadow_blur | plus: 8 }}px rgba(0, 0, 0, {{ block.settings.card_shadow_opacity | divided_by: 100.0 | times: 1.2 }});
  }

  .ai-problem-card-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    margin-bottom: {{ block.settings.card_image_spacing }}px;
    border-radius: {{ block.settings.card_image_border_radius }}px;
    overflow: hidden;
  }

  .ai-problem-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.card_image_height }}px;
    object-fit: cover;
    display: block;
  }

  .ai-problem-card-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.card_image_height }}px;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-problem-card-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-problem-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_title_font_size }}px;
    font-weight: {{ block.settings.card_title_font_weight }};
    color: {{ block.settings.card_title_color }};
    margin-bottom: {{ block.settings.card_title_spacing }}px;
  }

  .ai-problem-card-bullets-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-problem-card-bullet-{{ ai_gen_id }} {
    display: flex;
    align-items: flex-start;
    gap: {{ block.settings.bullet_icon_spacing }}px;
    margin-bottom: {{ block.settings.bullet_spacing }}px;
    font-size: {{ block.settings.bullet_font_size }}px;
    color: {{ block.settings.bullet_text_color }};
    line-height: 1.5;
  }

  .ai-problem-card-bullet-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-problem-bullet-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.bullet_icon_size }}px;
    height: {{ block.settings.bullet_icon_size }}px;
    margin-top: 2px;
  }

  .ai-problem-bullet-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: {{ block.settings.bullet_icon_color }};
    stroke-width: 2.5;
  }

  @media screen and (max-width: 989px) {
    .ai-problem-cards-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.cards_per_row_tablet }}, 1fr);
    }

    .ai-problem-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_font_size | times: 0.8 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-problem-cards-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-problem-headline-{{ ai_gen_id }} {
      font-size: {{ block.settings.headline_font_size | times: 0.65 }}px;
    }

    .ai-problem-label-{{ ai_gen_id }} {
      font-size: {{ block.settings.label_font_size | times: 0.9 }}px;
    }

    .ai-problem-subtext-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtext_font_size | times: 0.95 }}px;
    }
  }
{% endstyle %}

<problem-section-{{ ai_gen_id }} class="ai-problem-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-problem-container-{{ ai_gen_id }}">
    <div class="ai-problem-header-{{ ai_gen_id }}">
      {% if block.settings.label != blank %}
        <div class="ai-problem-label-{{ ai_gen_id }}">{{ block.settings.label }}</div>
      {% endif %}

      {% if block.settings.headline != blank %}
        <h2 class="ai-problem-headline-{{ ai_gen_id }}">
          {{ block.settings.headline_part_1 }}
          {% if block.settings.headline_accent != blank %}
            <span class="ai-problem-headline-accent-{{ ai_gen_id }}">{{ block.settings.headline_accent }}</span>
          {% endif %}
          {{ block.settings.headline_part_2 }}
        </h2>
      {% endif %}

      {% if block.settings.subtext != blank %}
        <p class="ai-problem-subtext-{{ ai_gen_id }}">{{ block.settings.subtext }}</p>
      {% endif %}
    </div>

    <div class="ai-problem-cards-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign card_image_key = 'card_' | append: i | append: '_image'
          assign card_title_key = 'card_' | append: i | append: '_title'
          assign card_bullet_1_key = 'card_' | append: i | append: '_bullet_1'
          assign card_bullet_2_key = 'card_' | append: i | append: '_bullet_2'
          assign card_bullet_3_key = 'card_' | append: i | append: '_bullet_3'
          assign card_bullet_4_key = 'card_' | append: i | append: '_bullet_4'

          assign card_image = block.settings[card_image_key]
          assign card_title = block.settings[card_title_key]
          assign card_bullet_1 = block.settings[card_bullet_1_key]
          assign card_bullet_2 = block.settings[card_bullet_2_key]
          assign card_bullet_3 = block.settings[card_bullet_3_key]
          assign card_bullet_4 = block.settings[card_bullet_4_key]
        %}

        <div class="ai-problem-card-{{ ai_gen_id }}">
          <div class="ai-problem-card-image-wrapper-{{ ai_gen_id }}">
            {% if card_image %}
              <img
                src="{{ card_image | image_url: width: 800 }}"
                alt="{{ card_image.alt | escape }}"
                loading="lazy"
                width="800"
                height="{{ block.settings.card_image_height }}"
                class="ai-problem-card-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-problem-card-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          {% if card_title != blank %}
            <h3 class="ai-problem-card-title-{{ ai_gen_id }}">{{ card_title }}</h3>
          {% endif %}

          <ul class="ai-problem-card-bullets-{{ ai_gen_id }}">
            {% if card_bullet_1 != blank %}
              <li class="ai-problem-card-bullet-{{ ai_gen_id }}">
                <span class="ai-problem-bullet-icon-{{ ai_gen_id }}">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </span>
                <span>{{ card_bullet_1 }}</span>
              </li>
            {% endif %}

            {% if card_bullet_2 != blank %}
              <li class="ai-problem-card-bullet-{{ ai_gen_id }}">
                <span class="ai-problem-bullet-icon-{{ ai_gen_id }}">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </span>
                <span>{{ card_bullet_2 }}</span>
              </li>
            {% endif %}

            {% if card_bullet_3 != blank %}
              <li class="ai-problem-card-bullet-{{ ai_gen_id }}">
                <span class="ai-problem-bullet-icon-{{ ai_gen_id }}">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </span>
                <span>{{ card_bullet_3 }}</span>
              </li>
            {% endif %}

            {% if card_bullet_4 != blank %}
              <li class="ai-problem-card-bullet-{{ ai_gen_id }}">
                <span class="ai-problem-bullet-icon-{{ ai_gen_id }}">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                  </svg>
                </span>
                <span>{{ card_bullet_4 }}</span>
              </li>
            {% endif %}
          </ul>
        </div>
      {% endfor %}
    </div>
  </div>
</problem-section-{{ ai_gen_id }}>

<script>
  (function() {
    class ProblemSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('problem-section-{{ ai_gen_id }}', ProblemSection{{ ai_gen_id }});
  })();
</script>

