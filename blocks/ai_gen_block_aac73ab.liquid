{% doc %}
  @prompt
    Create me a header for the Next seciton its going to be called "Benefits Backed By Science" I want the benefits backed by and science to be two different colors. Make that editable along with the fonts, sizes, spacing and everything., ok make it so i can edit background color
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-science-header-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_horizontal }}px;
    text-align: {{ block.settings.text_alignment }};
    background-color: {{ block.settings.background_color }};
  }

  .ai-science-header__title-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: {{ block.settings.line_height }};
    letter-spacing: {{ block.settings.letter_spacing }}px;
    margin: 0;
  }

  .ai-science-header__part1-{{ ai_gen_id }} {
    color: {{ block.settings.part1_color }};
  }

  .ai-science-header__part2-{{ ai_gen_id }} {
    color: {{ block.settings.part2_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-science-header__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-science-header-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h2 class="ai-science-header__title-{{ ai_gen_id }}">
    <span class="ai-science-header__part1-{{ ai_gen_id }}">{{ block.settings.part1_text }}</span>
    <span class="ai-science-header__part2-{{ ai_gen_id }}">{{ block.settings.part2_text }}</span>
  </h2>
</div>

{% schema %}
{
  "name": "Science header",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Text content"
    },
    {
      "type": "text",
      "id": "part1_text",
      "label": "First part",
      "default": "Benefits Backed By"
    },
    {
      "type": "text",
      "id": "part2_text",
      "label": "Second part",
      "default": "Science"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "part1_color",
      "label": "First part",
      "default": "#5fc4f2"
    },
    {
      "type": "color",
      "id": "part2_color",
      "label": "Second part",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Font",
      "default": "inter_n7"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Desktop font size",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Mobile font size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "line_height",
      "label": "Line height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.3
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0.5
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Science header"
    }
  ]
}
{% endschema %}
