{% doc %}
  @prompt
    Create a section with a header that says Cryo wipes used by everyone but make it so the word everyone is a different color. Also under that header i want a subheader that says over 700k view on social medias. Make all text fonts editable, size editable, color, spacing of section, and backgournd color editable
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign ai_header_extra_top = block.settings.extra_top_spacing | default: 0 %}
{% liquid
  assign ai_section_pad_bottom = block.settings.section_padding_bottom
  if ai_section_pad_bottom == blank
    assign ai_section_pad_bottom = block.settings.section_spacing
  endif
%}

{% style %}
  .ai-header-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    box-sizing: border-box;
    padding-top: {{ block.settings.section_spacing | plus: ai_header_extra_top }}px;
    padding-right: {{ block.settings.section_spacing }}px;
    padding-bottom: {{ ai_section_pad_bottom }}px;
    padding-left: {{ block.settings.section_spacing }}px;
    margin-top: 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-header-container-{{ ai_gen_id }} {
    max-width: 100%;
    margin: 0 auto;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-main-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px 0;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .ai-highlight-{{ ai_gen_id }} {
    background: var(--instant-text-color-gradient, linear-gradient(0deg, #2d6f9a, #58b6d6));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent !important;
    -webkit-text-fill-color: transparent;
  }

  .ai-subheading-{{ ai_gen_id }} {
    font-family: {{ block.settings.subheading_font.family }}, {{ block.settings.subheading_font.fallback_families }};
    font-weight: {{ block.settings.subheading_font.weight }};
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .ai-main-heading-{{ ai_gen_id }} {
      font-size: clamp(13px, 5.6vw, {{ block.settings.heading_size | times: 0.58 }}px);
      white-space: nowrap;
      letter-spacing: -0.02em;
    }

    .ai-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<div class="ai-header-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-header-container-{{ ai_gen_id }}">
    <h2 class="ai-main-heading-{{ ai_gen_id }}">
      {{ block.settings.heading_text_before }}
      <span class="ai-highlight-{{ ai_gen_id }}">{{ block.settings.heading_text_highlight }}</span>
      {{ block.settings.heading_text_after }}
    </h2>
    <p class="ai-subheading-{{ ai_gen_id }}">{{ block.settings.subheading_text }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Cryo wipes header",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Main heading"
    },
    {
      "type": "text",
      "id": "heading_text_before",
      "label": "Heading text before highlight",
      "default": "Cryo wipes used by"
    },
    {
      "type": "text",
      "id": "heading_text_highlight",
      "label": "Highlighted text",
      "default": "everyone"
    },
    {
      "type": "text",
      "id": "heading_text_after",
      "label": "Heading text after highlight",
      "default": " wants one",
      "info": "Shown after the gradient word. Include a leading space if it should separate from the highlight."
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Font",
      "default": "inter_n7"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Size",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color",
      "default": "#5fc4f2"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Bottom spacing",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Subheading"
    },
    {
      "type": "text",
      "id": "subheading_text",
      "label": "Subheading text",
      "default": "Over 700k views on social medias"
    },
    {
      "type": "font_picker",
      "id": "subheading_font",
      "label": "Font",
      "default": "harmonia_sans_n4"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "label": "Size",
      "min": 12,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Color",
      "default": "#5fc4f2"
    },
    {
      "type": "header",
      "content": "Section style"
    },
    {
      "type": "range",
      "id": "extra_top_spacing",
      "label": "Space above heading",
      "min": 0,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 0,
      "info": "Extra space above the headline (added to top padding). Removes the old upward nudge so this value is visible."
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "section_spacing",
      "label": "Section padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Padding below subheading",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 10,
      "info": "Space between the subheading and the section below (e.g. product cards). Left/right padding still uses Section padding."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#171717"
    }
  ],
  "presets": [
    {
      "name": "Cryo wipes header"
    }
  ]
}
{% endschema %}
