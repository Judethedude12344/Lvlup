{% doc %}
  @prompt
    I want to create a before and after slider section but i am able to have multiple before and after sliders and users can scroll to see the others , can you add the arrows for the middle line of the before and after photos. arrows to slide back and forth and also you forgot the after label. Make me able to customaize the before and after labels also. Make the whole picture from a circle instead of a square,  the before and after labels should be small and be on the outside of the circle. top left and top right of the circle is where the labels should be, the before and after images when i upload are on the wrong side of the circles, make the before and after labels closer to the picture. make option where we can change the color of the words and background color, make the labels background be the same exact shape , make the before and after buttons not touch the top of the section padding,  Also make it where if user drags the photos to scroll, they can do that easily  want the option to have arrows on the sides and the bottom so people are able to scroll to see the other photos, for the navigation bar, also make me an option where i can choose different style of the arrow placement for example at the bottom of the section with the left and right arrows and the ... in the middle and i can customize the arrows background and arrow size, Make the before photo align with the after photo., make me option to choose either the side navigation bar or the bottom. Add a title section. that will go at the top. The drag and slide to see other pictures on the screen is not fluid. Make the drag and scroll fluid and can go back and forth seeing different pictures. make the before and after labels go on the outside of pictures. The before will be on top left side of the picture. the after label goes top right of the after picture. make option where i can make it closer to the photo., everytime i try to drag the section to see next photos that are not on the screen, it jsut goes back to the first pictures. MAke it not glitch please., add option where i can customize the top and bottom padding. add option where i can space out the pictures. make where the handle has an option to be see through. Make the spacing from title and the pictures be closer. , make the before and after labels the exact size, The slider of each photo is malfunctioning. Make the slider like a before and after slider. It's glitching right now. The photos stay the same size when the slider moves, the slider and handle is not moving, the sliding between photos is too gltichy right now. Make it smoothe please, the top and bottom padding doesn't change when i change that. fix that. and the sliding between pictures needs to be even smoother. No lag at all please., the dragging to see other photos is gone. Add the drag back and don't make it glitchy, Make the dragging smooth and flow. Users can drag it to wherever they want. Right now it's dragging in pairs of twos. I want it to drag freely
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-ba-slider-container-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
    padding-top: {{ block.settings.section_padding_top }}px;
    padding-bottom: {{ block.settings.section_padding_bottom }}px;
  }

  .ai-ba-title-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: 700;
    margin-bottom: {{ block.settings.title_spacing }}px;
    color: {{ block.settings.title_color }};
  }

  .ai-ba-slider-wrapper-{{ ai_gen_id }} {
    position: relative;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-ba-slider-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.slider_gap }}px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: {{ block.settings.label_outer_offset }}px {{ block.settings.horizontal_spacing }}px;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: none;
    will-change: scroll-position;
    cursor: grab;
  }

  .ai-ba-slider-track-{{ ai_gen_id }}:active {
    cursor: grabbing;
  }

  .ai-ba-slider-track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-ba-slider-item-{{ ai_gen_id }} {
    flex: 0 0 {{ block.settings.item_width }}%;
    position: relative;
    aspect-ratio: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-ba-slider-item-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.item_width_mobile }}%;
    }
  }

  .ai-ba-comparison-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    overflow: hidden;
  }

  .ai-ba-image-container-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-ba-image-container-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    pointer-events: none;
    user-select: none;
  }

  .ai-ba-after-container-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-ba-before-container-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 50%;
    height: 100%;
    overflow: hidden;
    z-index: 2;
    will-change: width;
  }

  .ai-ba-before-container-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
  }

  .ai-ba-divider-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 4px;
    background-color: {{ block.settings.divider_color }};
    cursor: ew-resize;
    z-index: 3;
    transform: translateX(-50%);
    touch-action: none;
    will-change: left;
  }

  .ai-ba-divider-handle-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: {{ block.settings.handle_size }}px;
    height: {{ block.settings.handle_size }}px;
    background-color: {{ block.settings.handle_bg_color }};
    {% if block.settings.handle_transparent %}
      opacity: {{ block.settings.handle_opacity | divided_by: 100.0 }};
    {% endif %}
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    cursor: ew-resize;
  }

  .ai-ba-divider-arrows-{{ ai_gen_id }} {
    display: flex;
    gap: 2px;
    color: {{ block.settings.handle_arrow_color }};
    pointer-events: none;
  }

  .ai-ba-divider-arrows-{{ ai_gen_id }} svg {
    width: {{ block.settings.arrow_icon_size }}px;
    height: {{ block.settings.arrow_icon_size }}px;
  }

  .ai-ba-label-{{ ai_gen_id }} {
    position: absolute;
    z-index: 2;
    padding: {{ block.settings.label_padding_y }}px {{ block.settings.label_padding_x }}px;
    background-color: {{ block.settings.label_bg_color }};
    color: {{ block.settings.label_text_color }};
    font-size: {{ block.settings.label_font_size }}px;
    font-weight: 600;
    border-radius: {{ block.settings.label_border_radius }}px;
    pointer-events: none;
    white-space: nowrap;
    min-width: {{ block.settings.label_min_width }}px;
    text-align: center;
    display: inline-block;
  }

  .ai-ba-label-before-{{ ai_gen_id }} {
    top: calc(-1 * {{ block.settings.label_outer_offset }}px + {{ block.settings.label_distance }}px);
    left: 0;
  }

  .ai-ba-label-after-{{ ai_gen_id }} {
    top: calc(-1 * {{ block.settings.label_outer_offset }}px + {{ block.settings.label_distance }}px);
    right: 0;
  }

  .ai-ba-nav-arrows-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: {{ block.settings.nav_arrow_size }}px;
    height: {{ block.settings.nav_arrow_size }}px;
    background-color: {{ block.settings.nav_arrow_bg_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 4;
    transition: opacity 0.3s ease;
    border: none;
  }

  .ai-ba-nav-arrows-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-ba-nav-arrows-{{ ai_gen_id }} svg {
    width: {{ block.settings.nav_arrow_icon_size }}px;
    height: {{ block.settings.nav_arrow_icon_size }}px;
    fill: {{ block.settings.nav_arrow_color }};
  }

  .ai-ba-nav-arrow-left-{{ ai_gen_id }} {
    left: 10px;
  }

  .ai-ba-nav-arrow-right-{{ ai_gen_id }} {
    right: 10px;
  }

  {% if block.settings.nav_style == 'side_arrows' %}
    .ai-ba-nav-arrows-{{ ai_gen_id }} {
      display: flex;
    }
    .ai-ba-pagination-{{ ai_gen_id }} {
      display: none;
    }
  {% elsif block.settings.nav_style == 'bottom_arrows' %}
    .ai-ba-nav-arrows-{{ ai_gen_id }} {
      display: none;
    }
    .ai-ba-pagination-{{ ai_gen_id }} {
      display: flex;
    }
  {% else %}
    .ai-ba-nav-arrows-{{ ai_gen_id }} {
      display: none;
    }
    .ai-ba-pagination-{{ ai_gen_id }} {
      display: none;
    }
  {% endif %}

  .ai-ba-pagination-{{ ai_gen_id }} {
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-top: 30px;
  }

  .ai-ba-pagination-dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .ai-ba-pagination-dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.pagination_dot_color }};
    opacity: 0.3;
    cursor: pointer;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .ai-ba-pagination-dot-{{ ai_gen_id }}.active {
    opacity: 1;
    transform: scale(1.3);
  }

  .ai-ba-pagination-arrow-{{ ai_gen_id }} {
    width: {{ block.settings.pagination_arrow_size }}px;
    height: {{ block.settings.pagination_arrow_size }}px;
    background-color: {{ block.settings.pagination_arrow_bg_color }};
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: opacity 0.3s ease;
    border: none;
  }

  .ai-ba-pagination-arrow-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-ba-pagination-arrow-{{ ai_gen_id }} svg {
    width: {{ block.settings.pagination_arrow_icon_size }}px;
    height: {{ block.settings.pagination_arrow_icon_size }}px;
    fill: {{ block.settings.pagination_arrow_color }};
  }

  .ai-ba-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }
{% endstyle %}

<before-after-slider-{{ ai_gen_id }} class="ai-ba-slider-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank %}
    <h2 class="ai-ba-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
  {% endif %}

  {% assign has_items = false %}
  {% for i in (1..10) %}
    {% assign before_key = 'before_image_' | append: i %}
    {% assign after_key = 'after_image_' | append: i %}
    {% if block.settings[before_key] or block.settings[after_key] %}
      {% assign has_items = true %}
      {% break %}
    {% endif %}
  {% endfor %}

  {% if has_items %}
    <div class="ai-ba-slider-wrapper-{{ ai_gen_id }}">
      {% if block.settings.nav_style == 'side_arrows' %}
        <button class="ai-ba-nav-arrows-{{ ai_gen_id }} ai-ba-nav-arrow-left-{{ ai_gen_id }}" data-direction="prev" aria-label="Previous">
          <svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
        </button>
        <button class="ai-ba-nav-arrows-{{ ai_gen_id }} ai-ba-nav-arrow-right-{{ ai_gen_id }}" data-direction="next" aria-label="Next">
          <svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
        </button>
      {% endif %}

      <div class="ai-ba-slider-track-{{ ai_gen_id }}">
        {% for i in (1..10) %}
          {% assign before_key = 'before_image_' | append: i %}
          {% assign after_key = 'after_image_' | append: i %}
          {% assign before_image = block.settings[before_key] %}
          {% assign after_image = block.settings[after_key] %}

          {% if before_image or after_image %}
            <div class="ai-ba-slider-item-{{ ai_gen_id }}" data-index="{{ forloop.index0 }}">
              {% if block.settings.before_label != blank %}
                <div class="ai-ba-label-{{ ai_gen_id }} ai-ba-label-before-{{ ai_gen_id }}">
                  {{ block.settings.before_label }}
                </div>
              {% endif %}

              {% if block.settings.after_label != blank %}
                <div class="ai-ba-label-{{ ai_gen_id }} ai-ba-label-after-{{ ai_gen_id }}">
                  {{ block.settings.after_label }}
                </div>
              {% endif %}

              <div class="ai-ba-comparison-{{ ai_gen_id }}">
                <div class="ai-ba-after-container-{{ ai_gen_id }}">
                  <div class="ai-ba-image-container-{{ ai_gen_id }}">
                    {% if after_image %}
                      <img src="{{ after_image | image_url: width: 800 }}" alt="After" loading="lazy">
                    {% else %}
                      <div style="width: 100%; height: 100%; background: #f0f0f0; display: flex; align-items: center; justify-content: center;">
                        {{ 'image' | placeholder_svg_tag }}
                      </div>
                    {% endif %}
                  </div>
                </div>

                <div class="ai-ba-before-container-{{ ai_gen_id }}">
                  {% if before_image %}
                    <img src="{{ before_image | image_url: width: 800 }}" alt="Before" loading="lazy">
                  {% else %}
                    <div style="width: 100%; height: 100%; background: #e0e0e0; display: flex; align-items: center; justify-content: center;">
                      {{ 'image' | placeholder_svg_tag }}
                    </div>
                  {% endif %}
                </div>

                <div class="ai-ba-divider-{{ ai_gen_id }}">
                  <div class="ai-ba-divider-handle-{{ ai_gen_id }}">
                    <div class="ai-ba-divider-arrows-{{ ai_gen_id }}">
                      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
                      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% if block.settings.nav_style == 'bottom_arrows' %}
        <div class="ai-ba-pagination-{{ ai_gen_id }}">
          <button class="ai-ba-pagination-arrow-{{ ai_gen_id }}" data-direction="prev" aria-label="Previous">
            <svg viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
          </button>
          <div class="ai-ba-pagination-dots-{{ ai_gen_id }}"></div>
          <button class="ai-ba-pagination-arrow-{{ ai_gen_id }}" data-direction="next" aria-label="Next">
            <svg viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
          </button>
        </div>
      {% endif %}
    </div>
  {% else %}
    <div class="ai-ba-empty-state-{{ ai_gen_id }}">
      <p>Add before and after images to get started</p>
    </div>
  {% endif %}
</before-after-slider-{{ ai_gen_id }}>

<script>
(function() {
  class BeforeAfterSlider{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
      this.track = this.querySelector('.ai-ba-slider-track-{{ ai_gen_id }}');
      this.items = this.querySelectorAll('.ai-ba-slider-item-{{ ai_gen_id }}');
      this.navArrows = this.querySelectorAll('.ai-ba-nav-arrows-{{ ai_gen_id }}');
      this.paginationArrows = this.querySelectorAll('.ai-ba-pagination-arrow-{{ ai_gen_id }}');
      this.paginationDots = this.querySelector('.ai-ba-pagination-dots-{{ ai_gen_id }}');
      this.currentIndex = 0;
      this.isScrolling = false;
      this.isDraggingTrack = false;
    }

    connectedCallback() {
      if (!this.track || this.items.length === 0) return;

      this.initComparisons();
      this.initNavigation();
      this.initTrackDrag();
      this.initScrollTracking();
      this.createPaginationDots();
      this.updatePagination();
    }

    initComparisons() {
      this.items.forEach((item) => {
        const comparison = item.querySelector('.ai-ba-comparison-{{ ai_gen_id }}');
        const divider = item.querySelector('.ai-ba-divider-{{ ai_gen_id }}');
        const beforeContainer = item.querySelector('.ai-ba-before-container-{{ ai_gen_id }}');
        
        if (!comparison || !divider || !beforeContainer) return;

        let isDraggingDivider = false;

        const updatePosition = (clientX) => {
          const rect = comparison.getBoundingClientRect();
          const x = clientX - rect.left;
          const percentage = Math.max(0, Math.min(100, (x / rect.width) * 100));
          
          requestAnimationFrame(() => {
            divider.style.left = percentage + '%';
            beforeContainer.style.width = percentage + '%';
          });
        };

        const startDrag = (e) => {
          isDraggingDivider = true;
          e.preventDefault();
          e.stopPropagation();
          
          const clientX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
          updatePosition(clientX);
        };

        const stopDrag = () => {
          isDraggingDivider = false;
        };

        const onMove = (e) => {
          if (!isDraggingDivider) return;
          e.preventDefault();
          e.stopPropagation();
          
          const clientX = e.type.includes('touch') ? e.touches[0].clientX : e.clientX;
          updatePosition(clientX);
        };

        divider.addEventListener('mousedown', startDrag);
        divider.addEventListener('touchstart', startDrag, { passive: false });
        
        comparison.addEventListener('mousedown', (e) => {
          if (e.target === comparison || e.target.closest('.ai-ba-image-container-{{ ai_gen_id }}')) {
            startDrag(e);
          }
        });
        
        comparison.addEventListener('touchstart', (e) => {
          if (e.target === comparison || e.target.closest('.ai-ba-image-container-{{ ai_gen_id }}')) {
            startDrag(e);
          }
        }, { passive: false });
        
        document.addEventListener('mousemove', onMove);
        document.addEventListener('touchmove', onMove, { passive: false });
        
        document.addEventListener('mouseup', stopDrag);
        document.addEventListener('touchend', stopDrag);
      });
    }

    initTrackDrag() {
      let startX = 0;
      let scrollLeft = 0;
      let velocity = 0;
      let lastX = 0;
      let lastTime = 0;

      this.track.addEventListener('mousedown', (e) => {
        if (e.target.closest('.ai-ba-comparison-{{ ai_gen_id }}')) return;
        
        this.isDraggingTrack = true;
        startX = e.pageX;
        scrollLeft = this.track.scrollLeft;
        velocity = 0;
        lastX = e.pageX;
        lastTime = Date.now();
        this.track.style.scrollBehavior = 'auto';
      });

      this.track.addEventListener('mouseleave', () => {
        this.isDraggingTrack = false;
        this.track.style.scrollBehavior = 'smooth';
      });

      this.track.addEventListener('mouseup', () => {
        this.isDraggingTrack = false;
        this.track.style.scrollBehavior = 'smooth';
      });

      this.track.addEventListener('mousemove', (e) => {
        if (!this.isDraggingTrack) return;
        e.preventDefault();
        
        const currentTime = Date.now();
        const deltaTime = currentTime - lastTime;
        const deltaX = e.pageX - lastX;
        
        if (deltaTime > 0) {
          velocity = deltaX / deltaTime;
        }
        
        const x = e.pageX;
        const walk = (x - startX);
        this.track.scrollLeft = scrollLeft - walk;
        
        lastX = e.pageX;
        lastTime = currentTime;
      });

      let touchStartX = 0;
      let touchScrollLeft = 0;

      this.track.addEventListener('touchstart', (e) => {
        if (e.target.closest('.ai-ba-comparison-{{ ai_gen_id }}')) return;
        
        touchStartX = e.touches[0].pageX;
        touchScrollLeft = this.track.scrollLeft;
      }, { passive: true });

      this.track.addEventListener('touchmove', (e) => {
        if (e.target.closest('.ai-ba-comparison-{{ ai_gen_id }}')) return;
        
        const x = e.touches[0].pageX;
        const walk = touchStartX - x;
        this.track.scrollLeft = touchScrollLeft + walk;
      }, { passive: true });
    }

    initNavigation() {
      const allArrows = [...this.navArrows, ...this.paginationArrows];
      
      allArrows.forEach((arrow) => {
        arrow.addEventListener('click', () => {
          const direction = arrow.dataset.direction;
          if (direction === 'prev') {
            this.scrollToPrev();
          } else {
            this.scrollToNext();
          }
        });
      });
    }

    initScrollTracking() {
      let scrollTimeout;
      let rafId;
      
      this.track.addEventListener('scroll', () => {
        if (rafId) {
          cancelAnimationFrame(rafId);
        }
        
        rafId = requestAnimationFrame(() => {
          clearTimeout(scrollTimeout);
          scrollTimeout = setTimeout(() => {
            this.updateCurrentIndex();
          }, 100);
        });
      }, { passive: true });
    }

    createPaginationDots() {
      if (!this.paginationDots) return;

      this.paginationDots.innerHTML = '';
      this.items.forEach((item, index) => {
        const dot = document.createElement('div');
        dot.className = 'ai-ba-pagination-dot-{{ ai_gen_id }}';
        dot.addEventListener('click', () => this.scrollToIndex(index));
        this.paginationDots.appendChild(dot);
      });
    }

    updatePagination() {
      if (!this.paginationDots) return;

      const dots = this.paginationDots.querySelectorAll('.ai-ba-pagination-dot-{{ ai_gen_id }}');
      dots.forEach((dot, index) => {
        if (index === this.currentIndex) {
          dot.classList.add('active');
        } else {
          dot.classList.remove('active');
        }
      });
    }

    updateCurrentIndex() {
      const scrollLeft = this.track.scrollLeft;
      const itemWidth = this.items[0].offsetWidth;
      const gap = {{ block.settings.slider_gap }};
      const newIndex = Math.round(scrollLeft / (itemWidth + gap));
      
      if (newIndex !== this.currentIndex && newIndex >= 0 && newIndex < this.items.length) {
        this.currentIndex = newIndex;
        this.updatePagination();
      }
    }

    scrollToIndex(index) {
      if (index < 0 || index >= this.items.length || this.isScrolling) return;
      
      this.isScrolling = true;
      const itemWidth = this.items[0].offsetWidth;
      const gap = {{ block.settings.slider_gap }};
      const targetScroll = index * (itemWidth + gap);
      
      this.track.scrollTo({
        left: targetScroll,
        behavior: 'smooth'
      });
      
      this.currentIndex = index;
      this.updatePagination();
      
      setTimeout(() => {
        this.isScrolling = false;
      }, 600);
    }

    scrollToNext() {
      if (this.currentIndex < this.items.length - 1) {
        this.scrollToIndex(this.currentIndex + 1);
      }
    }

    scrollToPrev() {
      if (this.currentIndex > 0) {
        this.scrollToIndex(this.currentIndex - 1);
      }
    }
  }

  customElements.define('before-after-slider-{{ ai_gen_id }}', BeforeAfterSlider{{ ai_gen_id }});
})();
</script>

{% schema %}
{
  "name": "Before after slider",
  "settings": [
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Font size",
      "default": 32
    },
